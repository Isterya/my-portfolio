{
  "name": "my-portfolio",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint . --max-warnings=0 && stylelint \"**/*.{scss,css}\"",
    "lint:fix": "eslint . --fix && stylelint \"**/*.{scss,css}\" --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky",
    "preview": "vite preview",
    "test": "vitest run"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --max-warnings=0",
      "prettier --write"
    ],
    "*.{scss,css}": [
      "stylelint --fix",
      "prettier --write"
    ],
    "*.{js,cjs,mjs,json,md,html,yml,yaml}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/poppins": "^5.3.0",
    "i18next": "^27.0.1",
    "i18next-browser-languagedetector": "^8.3.0",
    "motion": "^14.10.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-helmet-async": "^3.0.0",
    "react-i18next": "^18.0.0",
    "react-router": "^8.5.1",
    "react-spinners": "^0.17.1"
  },
  "devDependencies": {
    "@eslint-react/eslint-plugin": "^5.28.8",
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "husky": "^9.1.7",
    "jiti": "^2.7.0",
    "lint-staged": "^16.4.0",
    "postcss-scss": "^4.0.9",
    "prettier": "^3.9.10",
    "sass": "^1.108.1",
    "stylelint": "^17.16.0",
    "stylelint-config-standard-scss": "^17.0.0",
    "stylelint-scss": "^7.4.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  }
}
